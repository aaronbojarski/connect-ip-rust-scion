[Unit]
Description=Connect-IP SCION Client Service
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=/etc/cirs/.progconf
ExecStart=/usr/local/bin/connect-ip-rust-scion client ${CLIENT_REMOTE_ADDRESS} --host ${CLIENT_HOST} --endhost-api ${CLIENT_ENDHOST_API} --snap-token ${CLIENT_SNAP_TOKEN} --ca-cert ${CLIENT_CA_CERT} --cert ${CLIENT_CERT} --key ${CLIENT_KEY} --routes ${CLIENT_ROUTES} --address-pool ${CLIENT_ADDRESS_POOL}
Restart=always
RestartSec=1
User=root
Group=root
StandardOutput=journal
StandardError=journal
