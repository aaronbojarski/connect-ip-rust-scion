[Unit]
Description=Connect-IP SCION Proxy Service
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/connect-ip-rust-scion proxy --config /etc/cirs/proxy-config.json
Restart=always
RestartSec=1
User=root
Group=root
StandardOutput=journal
StandardError=journal
